# SearchMate Backend Environment Configuration
APP_ENV=development
API_V1_PREFIX=/api/v1
PROJECT_NAME=SearchMate
DATABASE_URL=sqlite:///./searchmate.db
UPLOAD_DIR=./uploads

# Limits (MVP Guidelines)
MAX_FILE_SIZE_MB=10
MAX_PAPERS_PER_COLLECTION=5

# AI Provider Configuration
# Set your preferred provider: "groq", "xai", "gemini"
AI_PROVIDER=groq

# 1. Groq Cloud (Ultra-fast, Llama 3.3 70B, Recommended)
# Get key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 2. xAI Grok (Optional)
# Get key from https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-beta

# 3. Google Gemini (Optional)
# Get key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
